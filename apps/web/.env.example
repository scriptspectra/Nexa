# Required for the dashboard (apps/web) on Vercel
NEXT_PUBLIC_CONVEX_URL=https://accomplished-schnauzer-225.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=

# Widget script URL shown in Integrations (optional override)
# If unset, production uses https://widget.<your-domain>
NEXT_PUBLIC_WIDGET_URL=

# Shopify OAuth app (Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-domain.com
SHOPIFY_OAUTH_SERVER_SECRET=

# Public app URL used for OAuth redirect_uri
NEXT_PUBLIC_APP_URL=https://your-domain.com
